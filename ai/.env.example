# Model serving
CLINIGA_MODEL=Qwen/Qwen3-8B
# REQUIRED in production: immutable Hugging Face commit SHA for CLINIGA_MODEL
CLINIGA_MODEL_REVISION=
CLINIGA_SERVED_MODEL=cliniga-general
CLINIGA_MAX_MODEL_LEN=16384
CLINIGA_GPU_MEMORY_UTILIZATION=0.90

# API -> model server
CLINIGA_LLM_BASE_URL=http://vllm:8000/v1
CLINIGA_LLM_API_KEY=local
CLINIGA_GENERAL_MODEL=cliniga-general
CLINIGA_REASONING_MODEL=cliniga-general
CLINIGA_CODE_MODEL=cliniga-general

# Retrieval
CLINIGA_QDRANT_URL=http://qdrant:6333
CLINIGA_QDRANT_COLLECTION=cliniga_knowledge

# Distributed cache / rate limiting
CLINIGA_REDIS_URL=redis://redis:6379/0
CLINIGA_DISTRIBUTED_CONTROLS=true
CLINIGA_ALLOW_LOCAL_FALLBACK=false
CLINIGA_CACHE_TTL_SECONDS=300
CLINIGA_RATE_LIMIT=120
CLINIGA_RATE_WINDOW_SECONDS=60

# Persistent state / audit / jobs
CLINIGA_POSTGRES_DSN=postgresql://cliniga:change-me@postgres:5432/cliniga
CLINIGA_STATE_ENABLED=true
CLINIGA_AUDIT_FAIL_CLOSED=true

# Object storage
CLINIGA_S3_ENDPOINT=http://minio:9000
CLINIGA_S3_BUCKET=cliniga-ai
CLINIGA_S3_ACCESS_KEY=change-me
CLINIGA_S3_SECRET_KEY=change-me
CLINIGA_S3_REGION=us-east-1
CLINIGA_S3_SSE=
CLINIGA_MAX_UPLOAD_BYTES=26214400

# Tenant authentication / RBAC
# Backward compatible: {"tenant-a":"key-a"}
# Preferred: {"tenant-a":{"api_key":"key-a","role":"admin","subject":"service-a"}}
CLINIGA_TENANT_KEYS_JSON=
CLINIGA_ALLOW_INSECURE_DEV_AUTH=false
CLINIGA_DEV_ROLE=admin

# Optional AWS Secrets Manager source for tenant credential JSON
CLINIGA_TENANT_KEYS_SECRET_ID=
CLINIGA_SECRETS_REGION=

# OpenTelemetry / OTLP (leave blank to disable tracing export)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=cliniga-ai-engine

HUGGING_FACE_HUB_TOKEN=
