# Immutable deployment images (required by docker compose; use approved digest references)
CLINIGA_APP_IMAGE=
CLINIGA_QDRANT_IMAGE=
CLINIGA_REDIS_IMAGE=
# Must include the pgvector extension used by ai/migrations/002_vectors.sql
CLINIGA_POSTGRES_IMAGE=
CLINIGA_MINIO_IMAGE=
CLINIGA_VLLM_IMAGE=
CLINIGA_BIND_HOST=127.0.0.1

# Model serving
CLINIGA_MODEL=Qwen/Qwen3-8B
# REQUIRED in production: immutable Hugging Face commit SHA for CLINIGA_MODEL
CLINIGA_MODEL_REVISION=
CLINIGA_SERVED_MODEL=cliniga-general
CLINIGA_MAX_MODEL_LEN=16384
CLINIGA_GPU_MEMORY_UTILIZATION=0.90

# API -> model server
CLINIGA_LLM_BASE_URL=http://vllm:8000/v1
CLINIGA_LLM_API_KEY=
CLINIGA_GENERAL_MODEL=cliniga-general
CLINIGA_REASONING_MODEL=cliniga-general
CLINIGA_CODE_MODEL=cliniga-general

# Local evidence and evaluation roots (blank disables these capabilities)
CLINIGA_DOCUMENT_ROOT=
CLINIGA_SCIENTIFIC_SOURCE_ROOT=
CLINIGA_EVAL_MODEL_ROOT=
CLINIGA_EVAL_OUTPUT_ROOT=
CLINIGA_ENABLE_LM_EVAL_ISOLATED=false

# Retrieval and vector routing
CLINIGA_QDRANT_URL=http://qdrant:6333
CLINIGA_QDRANT_COLLECTION=cliniga_knowledge
CLINIGA_VECTOR_DEFAULT_BACKEND=qdrant
CLINIGA_VECTOR_RESTRICTED_BACKEND=pgvector
# Disable Haystack's optional product telemetry; use the controlled OTLP layer below.
HAYSTACK_TELEMETRY_ENABLED=false

# Distributed cache / rate limiting
CLINIGA_REDIS_URL=redis://redis:6379/0
CLINIGA_DISTRIBUTED_CONTROLS=true
CLINIGA_ALLOW_LOCAL_FALLBACK=false
CLINIGA_CACHE_TTL_SECONDS=300
CLINIGA_RATE_LIMIT=120
CLINIGA_RATE_WINDOW_SECONDS=60

# Persistent state / audit / jobs
CLINIGA_POSTGRES_PASSWORD=
CLINIGA_POSTGRES_DSN=
CLINIGA_STATE_ENABLED=true
CLINIGA_AUDIT_FAIL_CLOSED=true

# Temporal durable workflows (blank disables Temporal)
CLINIGA_TEMPORAL_ADDRESS=
CLINIGA_TEMPORAL_NAMESPACE=default
CLINIGA_TEMPORAL_TASK_QUEUE=cliniga-ai

# Object storage
CLINIGA_S3_ENDPOINT=http://minio:9000
CLINIGA_S3_BUCKET=cliniga-ai
CLINIGA_S3_ACCESS_KEY=
CLINIGA_S3_SECRET_KEY=
CLINIGA_S3_REGION=us-east-1
CLINIGA_S3_SSE=
CLINIGA_MAX_UPLOAD_BYTES=26214400

# Tenant authentication / RBAC
CLINIGA_TENANT_KEYS_JSON=
CLINIGA_ALLOW_INSECURE_DEV_AUTH=false
CLINIGA_DEV_ROLE=admin

# Optional AWS Secrets Manager source for tenant credential JSON
CLINIGA_TENANT_KEYS_SECRET_ID=
CLINIGA_SECRETS_REGION=

# OpenTelemetry / OTLP (leave blank to disable tracing export)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=cliniga-ai-engine

# Optional Helicone-compatible proxy. Both values are required to enable it.
# Production proxy URLs must use HTTPS. Prompt/response content is never added to custom telemetry fields.
CLINIGA_HELICONE_PROXY_URL=
HELICONE_API_KEY=
CLINIGA_ALLOW_INSECURE_TELEMETRY=false

HUGGING_FACE_HUB_TOKEN=
