# Model serving
CLINIGA_MODEL=Qwen/Qwen3-8B
CLINIGA_SERVED_MODEL=cliniga-general
CLINIGA_MAX_MODEL_LEN=16384
CLINIGA_GPU_MEMORY_UTILIZATION=0.90

# API -> model server
CLINIGA_LLM_BASE_URL=http://vllm:8000/v1
CLINIGA_LLM_API_KEY=local
CLINIGA_GENERAL_MODEL=cliniga-general
CLINIGA_REASONING_MODEL=cliniga-general
CLINIGA_CODE_MODEL=cliniga-general

# Retrieval
CLINIGA_QDRANT_URL=http://qdrant:6333
CLINIGA_QDRANT_COLLECTION=cliniga_knowledge

# Optional gated Hugging Face models
HUGGING_FACE_HUB_TOKEN=
