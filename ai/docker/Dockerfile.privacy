FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY ai/requirements.txt ai/requirements-privacy.txt /tmp/cliniga/
RUN pip install -r /tmp/cliniga/requirements.txt -r /tmp/cliniga/requirements-privacy.txt
COPY . /workspace

CMD ["python", "-c", "from ai.privacy.presidio_guard import redact_sensitive_text; print(redact_sensitive_text('Contact: test@example.com').redaction_count)"]
