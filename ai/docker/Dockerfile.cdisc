FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/home/cliniga

RUN apt-get update \
    && apt-get install -y --no-install-recommends git build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 --shell /usr/sbin/nologin cliniga

WORKDIR /workspace
COPY ai/requirements-cdisc.txt /tmp/cliniga/requirements-cdisc.txt
RUN pip install -r /tmp/cliniga/requirements-cdisc.txt \
    && chown -R cliniga:cliniga /workspace /home/cliniga

USER cliniga
# This image is a rules/batch runtime, not a public network service.
CMD ["python", "-c", "import cdisc_rules_engine; print('CDISC Rules Engine ready')"]
